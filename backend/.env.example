############################################################
# Clinex Application — Environment Configuration
# Copy this file to .env and fill in the values.
#
# For INTRANET deployment:
#   - Set APP_ENV=production
#   - Set APP_DEBUG=false
#   - Use strong, unique passwords for DB
#   - Set FRONTEND_URL to the intranet hostname
############################################################

APP_NAME=Clinex
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://clinex.local

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database — USE STRONG PASSWORDS IN PRODUCTION
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=clinex
DB_USERNAME=clinex
DB_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# Frontend URL — comma-separated list of allowed origins
FRONTEND_URL="https://clinex.local"

# Google Document AI credentials
GOOGLE_APPLICATION_CREDENTIALS=app/google/your-service-account.json
GOOGLE_CLOUD_PROJECT_ID=your-project-id
GOOGLE_CLOUD_LOCATION=asia-southeast1
GOOGLE_CLOUD_DOCUMENT_AI_PROCESSOR_ID=your-processor-id

# PaddleOCR Configuration (alternative/fallback OCR engine)
PADDLE_OCR_ENABLED=false
PADDLE_OCR_LANGUAGE=ch
PADDLE_OCR_CONFIDENCE_THRESHOLD=0.85
# Device selection: auto (prefer GPU if available, else CPU), gpu, cpu
PADDLE_OCR_DEVICE=auto
# GPU index to use when device is auto/gpu
PADDLE_OCR_GPU_ID=0

# Kiri OCR Configuration (Khmer-specialized local OCR engine)
# Transformer model optimized for Khmer + English text recognition
# Runs 100% locally — no cloud dependency
KIRI_OCR_ENABLED=true
KIRI_OCR_DECODE_METHOD=accurate
# Decode methods: fast (CTC), accurate (CTC+attention), beam (best quality)
KIRI_OCR_CONFIDENCE_THRESHOLD=0.7

# Session — encrypt for medical data protection
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_DRIVER=reverb
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail — configure for your intranet mail server
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=your-mail-server.local
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@clinex.local"
MAIL_FROM_NAME="Clinex System"

VITE_APP_NAME="${APP_NAME}"

# Reverb WebSocket (generate unique keys with: php artisan reverb:install)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8081
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"